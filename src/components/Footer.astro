---
import { site } from '../data/site';
import { withBase } from '../lib/urls';
---
<footer class="site-footer"><div class="container"><div class="footer-top"><div><a href={withBase('/')} class="footer-name">{site.name}<span>{site.program}<br />{site.university} · Degree in progress</span></a><div class="footer-contact"><a href={`mailto:${site.email}`}>Email me <span aria-hidden="true">↗</span></a><a href={`tel:${site.phoneCanonical}`}>{site.phoneDisplay}</a></div></div><nav aria-label="Footer navigation"><a href={withBase('/projects/')}>Projects</a><a href={withBase('/experience/')}>Experience</a><a href={withBase('/education/')}>Education</a><a href={withBase('/certificates/')}>Certificates</a><a href={withBase('/research/')}>Research</a><a href={withBase('/achievements/')}>Achievements</a><a href={withBase('/about/')}>About</a><a href={withBase('/contact/')}>Contact</a><a href={site.linkedin}>LinkedIn ↗</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span><span>{site.location}</span><span>Built with care & curiosity.</span></div></div></footer>
