---
interface Props { kind: 'phone' | 'whatsapp' | 'email' | 'linkedin' | 'github'; }
const { kind } = Astro.props;
---
<svg class="contact-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true" focusable="false" data-contact-icon={kind}>
  {kind === 'phone' && <path d="M7.1 3.5H4.5a1.5 1.5 0 0 0-1.5 1.6C3.5 13.6 10.4 20.5 18.9 21a1.5 1.5 0 0 0 1.6-1.5v-2.6a1.5 1.5 0 0 0-1.2-1.5l-3.2-.6a1.5 1.5 0 0 0-1.4.5l-1.3 1.6a15.9 15.9 0 0 1-6.3-6.3l1.6-1.3a1.5 1.5 0 0 0 .5-1.4l-.6-3.2a1.5 1.5 0 0 0-1.5-1.2Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />}
  {kind === 'whatsapp' && <>
    <path d="M20.5 11.6a8.5 8.5 0 0 1-12.8 7.3L3 20.2l1.3-4.6a8.5 8.5 0 1 1 16.2-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    <path d="M8.2 7.4c-.4 0-1 .5-1 1.4 0 2.3 3.6 6 6.4 6.8 1.5.4 2.6-.5 2.8-1.3.1-.3-.1-.5-.4-.6l-1.9-.9c-.3-.2-.5-.1-.7.2l-.6.8c-1.6-.5-3.1-2-3.7-3.4l.6-.8c.2-.3.2-.5.1-.8l-.8-1.8c-.1-.3-.3-.6-.8-.6Z" fill="currentColor" />
  </>}
  {kind === 'email' && <>
    <path d="M3 6.5v12h3.2V9L3 6.5Z" fill="#4285F4" />
    <path d="M17.8 9v9.5H21v-12L17.8 9Z" fill="#34A853" />
    <path d="m3 6.5 3.2 2.5L12 13.5 17.8 9 21 6.5" stroke="#EA4335" stroke-width="3.2" stroke-linejoin="round" />
    <path d="M3 6.5v3l3.2 2.5V9L3 6.5Z" fill="#EA4335" />
    <path d="M17.8 9v3L21 9.5v-3L17.8 9Z" fill="#FBBC04" />
  </>}
  {kind === 'linkedin' && <>
    <rect x="3" y="3" width="18" height="18" rx="2.3" stroke="currentColor" stroke-width="1.6" />
    <circle cx="7.4" cy="7.4" r="1.1" fill="currentColor" />
    <path d="M7.4 10.5v6.8m4.3 0v-6.8m0 3.1c0-3.7 5-3.8 5-.2v3.9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  </>}
  {kind === 'github' && <path d="M12 2.5a9.5 9.5 0 0 0-3 18.5c.5.1.6-.2.6-.5v-1.9c-2.7.6-3.3-1.1-3.3-1.1-.4-1.1-1-1.4-1-1.4-.8-.6.1-.6.1-.6.9.1 1.4.9 1.4.9.8 1.4 2.2 1 2.8.8.1-.6.3-1 .6-1.3-2.2-.2-4.5-1.1-4.5-4.8 0-1.1.4-2 1-2.6-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.6 1a9.1 9.1 0 0 1 5.1 0c1.8-1.3 2.6-1 2.6-1 .5 1.3.2 2.3.1 2.6.6.6 1 1.5 1 2.6 0 3.7-2.3 4.6-4.5 4.8.4.3.7.9.7 1.8v2.8c0 .3.1.6.6.5A9.5 9.5 0 0 0 12 2.5Z" fill="currentColor" />}
</svg>
<style>
  @layer components {
    .contact-icon { flex: none; width: 24px; height: 24px; color: var(--accent); }
  }
</style>
