---
import { withBase } from '../lib/urls';
interface Props { active?: string; }
const { active } = Astro.props;
const links = ['Projects', 'Experience', 'Research'];
const background = ['About', 'Education', 'Certificates', 'Achievements'];
---
<header class="site-header"><div class="container header-inner">
  <a class="wordmark" href={withBase('/')} aria-label="Muhammad Sharjeel — home"><span class="logo-mark" aria-hidden="true">MS<span>.</span></span><span class="wordmark-name">Muhammad Sharjeel<span>Electrical Engineering</span></span></a>
  <button class="menu-toggle" type="button" aria-controls="primary-nav" aria-expanded="false" hidden>Menu <span aria-hidden="true">＋</span></button>
  <nav id="primary-nav" class="primary-nav" aria-label="Main navigation">{links.map(label => <a href={withBase(`/${label.toLowerCase()}/`)} aria-current={active === label.toLowerCase() ? 'page' : undefined}>{label}</a>)}<details class:list={['background-menu', { 'background-active': background.some(label => label.toLowerCase() === active) }]}><summary>Background <span aria-hidden="true">⌄</span></summary><div class="background-links">{background.map(label => <a href={withBase(`/${label.toLowerCase()}/`)} aria-current={active === label.toLowerCase() ? 'page' : undefined}>{label}</a>)}</div></details><a class="nav-contact" href={withBase('/contact/')} aria-current={active === 'contact' ? 'page' : undefined}>Let’s connect <span aria-hidden="true">↗</span></a></nav>
</div></header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-nav');
  if (button && nav) {
    button.hidden = false;
    nav.classList.add('enhanced');
    const background = nav.querySelector<HTMLDetailsElement>('.background-menu');
    const close = () => { button.setAttribute('aria-expanded', 'false'); nav.classList.remove('is-open'); if (background) background.open = false; };
    button.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') !== 'true'; button.setAttribute('aria-expanded', String(open)); nav.classList.toggle('is-open', open); });
    nav.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) close(); });
    document.addEventListener('keydown', event => { if (event.key !== 'Escape') return; if (background?.open) { background.open = false; background.querySelector('summary')?.focus(); } else if (nav.classList.contains('is-open')) { close(); button.focus(); } });
    document.addEventListener('click', event => { if (background?.open && !background.contains(event.target as Node)) background.open = false; });
    matchMedia('(min-width: 941px)').addEventListener('change', close);
  }
</script>
