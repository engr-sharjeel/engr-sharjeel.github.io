---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import '../styles/viewer.css';
import '../styles/navigation.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImageViewer from '../components/ImageViewer.astro';
import { site } from '../data/site';
import pageMeta from '../data/page-meta.json';
import { withBase } from '../lib/urls';
interface Props { title?: string; description?: string; active?: string; }
const { title, description = site.description, active } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Power, Control & Mobility`;
const production = Astro.site || new URL('https://engr-sharjeel.github.io/');
const relativePath = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/+$/, '').length);
const segments = relativePath.split('/').filter(Boolean);
const notFound = relativePath === '/404.html' || relativePath === '/404/';
const canonical = new URL(notFound ? withBase('/404.html') : Astro.url.pathname, production).href;
const shareKey = segments.length > 1 && segments[0] === 'projects' ? segments[1] : (segments[0] || 'home');
const shareImage = new URL(withBase(`/social/${notFound ? 'home' : shareKey}.png`), production).href;
const crumbs = [{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL(withBase('/'), production).href }];
if (segments.length > 1 && segments[0] === 'projects') crumbs.push({ '@type': 'ListItem', position: 2, name: 'Projects', item: new URL(withBase('/projects/'), production).href });
if (segments.length && !notFound) crumbs.push({ '@type': 'ListItem', position: crumbs.length + 1, name: title || pageMeta[shareKey as keyof typeof pageMeta]?.title || 'Portfolio', item: canonical });
const structured = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${production.href}#website`, url: production.href, name: `${site.name} — Engineering portfolio`, inLanguage: 'en' },
    { '@type': 'Person', '@id': `${production.href}#person`, name: site.name, url: new URL(withBase('/about/'), production).href, description: site.role, email: site.email, telephone: site.phoneCanonical, sameAs: [site.linkedin, site.github], homeLocation: { '@type': 'Place', name: site.location } },
    ...(!notFound ? [{ '@type': 'BreadcrumbList', itemListElement: crumbs }] : []),
  ],
};
const jsonLd = JSON.stringify(structured).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1220" />
    <meta name="color-scheme" content="dark" />
    {notFound && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name} — Engineering portfolio`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_PK" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title || 'Engineering portfolio'} — ${site.name}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={`${title || 'Engineering portfolio'} — ${site.name}`} />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body><a class="skip-link" href="#main-content">Skip to content</a><Header active={active} /><main id="main-content" tabindex="-1"><slot /></main><Footer /><ImageViewer /></body>
</html>
