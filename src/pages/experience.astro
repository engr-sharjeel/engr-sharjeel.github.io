---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Tag from '../components/Tag.astro';
import ImageFrame from '../components/ImageFrame.astro';
import { experience } from '../data/experience';
import { certificates } from '../data/certificates';
import { withBase } from '../lib/urls';
import '../styles/phase2-pages.css';
---

<Layout title="Experience" description="Engineering internship exposure at IESCO and POWERCHINA SEPCO1, with Muhammad Sharjeel." active="experience">
  <div class="container">
    <section class="page-intro">
      <p class="eyebrow">Experience</p>
      <h1>Learning where<br />engineering happens.</h1>
      <p class="intro-copy">Two internships provided practical context for power-engineering coursework: utility operations and the coordination of engineering projects.</p>
    </section>
    <section class="section" aria-labelledby="internships-heading">
      <SectionHeading eyebrow="Industry exposure" title="Internships" id="internships-heading" />
      <div class="timeline">
        {experience.map((item) => (
          <article class="timeline-item" id={item.id}>
            <p class="eyebrow">{item.period}</p>
            <div class="record-header">
              <h3>{item.organization}</h3>
              <Tag>{item.role}</Tag>
            </div>
            <p class="record-lead">{item.summary}</p>
            <h4>Exposure & activities</h4>
            <ul class="prose">{item.activities.map((activity) => <li>{activity}</li>)}</ul>
            <div class="prose detail-section">
              <h4>Learning context</h4>
              {item.learning.map((point) => <p>{point}</p>)}
            </div>
            <ul class="tags" role="list">{item.areas.map((area) => <li><Tag>{area}</Tag></li>)}</ul>
            <div class="button-row">
              {certificates.filter((credential) => credential.experienceId === item.id).map((credential) => (
                <a class="link-arrow" href={withBase(`/certificates/#${credential.slug}`)}>View internship credential <span aria-hidden="true">↗</span></a>
              ))}
            </div>
            {item.images.length > 0 && <div class:list={['detail-gallery', 'experience-gallery', {'gallery-portrait-lead': item.images.length > 2 && item.images[0].src.width / item.images[0].src.height < .8}]}>{item.images.map((image) => <ImageFrame image={image} detail context="experience" gallery={`experience-${item.id}`} viewerTitle={`${item.organization} · Internship context`} />)}</div>}
          </article>
        ))}
      </div>
    </section>
    <section class="section two-column" aria-labelledby="experience-contact-heading">
      <SectionHeading eyebrow="Next steps" title="Open to learning and collaboration" id="experience-contact-heading" />
      <div class="prose">
        <p>I’m interested in opportunities that deepen my practical understanding of electrical power systems, embedded control and electric mobility.</p>
        <a class="link-arrow" href={withBase('/contact/')}>Get in touch <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .timeline-item h4 { font-size: 1.1rem; margin-block: 24px 14px; }
  .timeline-item .detail-section { padding-block: 8px 24px; margin-bottom: 24px; }
  .timeline-item .button-row { margin-top: 20px; }
</style>
