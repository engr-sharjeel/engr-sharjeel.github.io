---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Flagship from '../components/Flagship.astro';
import Button from '../components/Button.astro';
import { featuredProjects, site } from '../data/site';
import { experience } from '../data/experience';
import { research } from '../data/research';
import { withBase } from '../lib/urls';
const projects = await getCollection('projects');
const selected = featuredProjects.map(slug => projects.find(p => p.data.slug === slug)!);
if (selected.some(p => !p)) throw new Error('Every featured slug must resolve to a project.');
const flagship = selected.find(p => p.data.flagship)!;
const supporting = selected.filter(p => p !== flagship);
const published = research.find(record => record.status === 'Published paper')!;
---
<Layout>
  <section class="hero container"><div class="hero-copy"><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>Electrical (Power) Engineering Undergraduate</p><h1>Muhammad<br />Sharjeel<span class="accent">.</span></h1><p class="hero-focus">Power systems.<br />Embedded control.<br /><span>Electric mobility.</span></p><p class="hero-description">Exploring how electrical systems are designed, controlled and brought together—from practical embedded prototypes to a range extended electric vehicle at Air University, Islamabad.</p><div class="hero-actions"><Button href={withBase('/projects/')}>Explore my work</Button><a class="text-link" href={withBase('/about/')}>A little about me <span aria-hidden="true">↗</span></a></div></div>
  <div class="identity-panel"><div class="identity-top"><span class="eyebrow">Engineering in progress</span><span class="crosshair" aria-hidden="true">＋</span></div><div class="identity-art">{site.profileImage ? <Image src={site.profileImage} alt={site.profileAlt} widths={[400, 640, 900]} sizes="(max-width: 800px) 90vw, 40vw" loading="eager" format="webp" /> : <><div class="monogram" aria-hidden="true">M<span>S</span><i></i></div><div class="orbit orbit-one" aria-hidden="true"></div><div class="orbit orbit-two" aria-hidden="true"></div></>}</div><div class="identity-bottom"><span>MS / Electrical & Power</span><span>Islamabad, PK</span></div></div>
  </section>
  <div class="focus-strip"><div class="container"><span>Areas of focus</span><p>Power engineering <i aria-hidden="true">/</i> Electric mobility <i aria-hidden="true">/</i> Embedded systems</p></div></div>
  <section class="container section"><SectionHeading eyebrow="01 / Selected work" title="Ideas, engineered." description="Academic design studies and hands-on prototypes. Each project reflects a different part of the engineering process."><a class="link-arrow" href={withBase('/projects/')}>View all projects <span aria-hidden="true">↗</span></a></SectionHeading><Flagship project={flagship} /><div class="project-grid selected-grid">{supporting.map(project => <ProjectCard project={project} />)}</div></section>
  <section class="container section experience-home"><SectionHeading eyebrow="02 / Field experience" title="Learning beyond the lab." description="Industry exposure connects classroom concepts with the equipment, people and procedures behind real power systems." /><div class="experience-preview">{experience.map(record => <a class="experience-row" href={withBase('/experience/')}><span class="eyebrow">{record.period}</span><div><h3>{record.organization}</h3><p>{record.summary}</p></div><span class="row-end">{record.role} <b aria-hidden="true">↗</b></span></a>)}</div></section>
  <section class="container section research-home"><div><p class="eyebrow">03 / Research & writing</p><h2>Engineering in a<br />wider context.</h2><p class="section-description">From engineering education to distribution networks and electric mobility, research is part of how I examine technical questions.</p><a class="link-arrow" href={withBase('/research/')}>Explore research <span aria-hidden="true">↗</span></a></div><a class="research-preview" href={withBase('/research/')}><span class="eyebrow">{published.status} / {published.year}</span><h3>{published.title}</h3><p>{published.summary} {published.publication}.</p><span class="link-arrow">Read the research record <span aria-hidden="true">↗</span></span></a></section>
  <section class="container contact-banner"><p class="eyebrow">Have a question or an opportunity?</p><div><h2>Let’s connect<span class="accent">.</span></h2><Button href={withBase('/contact/')}>Get in touch</Button></div><p>I welcome conversations about power systems, embedded control, electric mobility and engineering research.</p></section>
</Layout>
