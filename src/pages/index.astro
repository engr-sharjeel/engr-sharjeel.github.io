---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Flagship from '../components/Flagship.astro';
import Button from '../components/Button.astro';
import ContactMethods from '../components/ContactMethods.astro';
import { featuredProjects, site } from '../data/site';
import { experience } from '../data/experience';
import { research } from '../data/research';
import { education } from '../data/education';
import { certificates } from '../data/certificates';
import { withBase } from '../lib/urls';
import { imageSizes, imageWidths } from '../lib/image-sizes';
import { softwareTools, engineeringSkills } from '../data/skills';
import '../styles/phase2-pages.css';
const projects = await getCollection('projects');
const selected = featuredProjects.map(slug => projects.find(p => p.data.slug === slug)!);
if (selected.some(p => !p)) throw new Error('Every featured slug must resolve to a project.');
const flagship = selected.find(p => p.data.flagship)!;
const supporting = selected.filter(p => p !== flagship);
const researchPreview = research[0];
---
<Layout>
  <section class="hero container" aria-labelledby="identity-heading">
    <div class="hero-copy"><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{site.program} · {site.degreeStatus}</p><h1 id="identity-heading">Muhammad<br />Sharjeel<span class="accent">.</span></h1><p class="hero-description hero-brief">{site.heroBrief}</p><p class="hero-university">{site.university}<span class="muted">Undergraduate · Islamabad, Pakistan</span></p><div class="hero-actions"><Button href={withBase('/projects/')}>Explore my work</Button><a class="button button-secondary" href={withBase(site.resumePath)} download>Download CV <span class="sr-only">(PDF)</span><span aria-hidden="true">↓</span></a><a class="text-link" href={withBase('/contact/')}>Contact me <span aria-hidden="true">↗</span></a></div></div>
    <div class="identity-panel"><div class="identity-top"><span class="eyebrow">Electrical engineering in practice</span><span class="crosshair" aria-hidden="true">＋</span></div><div class="identity-art">{site.profileImage ? <Image src={site.profileImage} alt={site.profileAlt} widths={imageWidths(site.profileImage.width)} sizes={imageSizes('portrait')} loading="eager" fetchpriority="high" decoding="async" format="webp" style={`object-position: ${site.profileFocalPoint}`} /> : <span class="portrait-fallback">Muhammad Sharjeel</span>}</div><div class="identity-bottom"><span>{site.name}</span><span>Islamabad, Pakistan</span></div></div>
  </section>
  <div class="focus-strip"><div class="container"><span>Areas of focus</span><p>Power engineering <i aria-hidden="true">/</i> Electric mobility <i aria-hidden="true">/</i> Embedded systems</p></div></div>
  <section class="container section"><SectionHeading eyebrow="01 / Selected work" title="Ideas, engineered." description="Academic design studies and hands-on prototypes. Each project reflects a different part of the engineering process."><a class="link-arrow" href={withBase('/projects/')}>View all projects <span aria-hidden="true">↗</span></a></SectionHeading><Flagship project={flagship} /><div class="project-grid selected-grid">{supporting.map((project, index) => <ProjectCard project={project} wideOnTablet={index === supporting.length - 1} />)}</div></section>
  <section class="container section experience-home"><SectionHeading eyebrow="02 / Field experience" title="Learning beyond the lab." description="Industry exposure connects classroom concepts with the equipment, people and procedures behind real power systems."><a class="link-arrow" href={withBase('/experience/')}>Explore internships <span aria-hidden="true">↗</span></a></SectionHeading><div class="experience-preview">{experience.map(record => <a class="experience-row" href={withBase(`/experience/#${record.id}`)}><span class="eyebrow">{record.period}</span><div><h3>{record.organization}</h3><p>{record.summary}</p></div><span class="row-end">{record.role} <b aria-hidden="true">↗</b></span></a>)}</div></section>
  <section class="container section" aria-labelledby="learning-home-heading"><SectionHeading eyebrow="03 / Education & contribution" title="A foundation built through study." description="Power-engineering coursework, continued learning and contributions to the university community." id="learning-home-heading" /><div class="discovery-grid">
    <a class="discovery-card" href={withBase('/education/')}><p class="eyebrow">Education · {education.status}</p><h3>Study at Air University</h3><p>{education.program}, academic focus areas and selected coursework linked to practical projects.</p><span class="link-arrow">Explore education <span aria-hidden="true">↗</span></span></a>
    <a class="discovery-card" href={withBase('/certificates/')}><p class="eyebrow">Certificates · {certificates.length} records</p><h3>Learning with a record</h3><p>Engineering and safety courses, internship credentials, language qualification and recognition.</p><span class="link-arrow">Browse certificates <span aria-hidden="true">↗</span></span></a>
    <a class="discovery-card" href={withBase('/achievements/')}><p class="eyebrow">Achievements</p><h3>Recognition & community</h3><p>Academic commendations and supported contributions, including campus ambassador and university activities.</p><span class="link-arrow">View achievements <span aria-hidden="true">↗</span></span></a>
    <a class="discovery-card" href={withBase('/about/')}><p class="eyebrow">About</p><h3>The person behind the work</h3><p>My engineering background, interests and the skills developed through study and supervised industry exposure.</p><span class="link-arrow">Read about me <span aria-hidden="true">↗</span></span></a>
  </div></section>
  <section class="container section research-home"><div><p class="eyebrow">04 / Research & writing</p><h2>Questions behind the work.</h2><p class="section-description">Electric mobility and distribution networks are part of my research interests, alongside a published coauthored paper on engineering education.</p><a class="link-arrow" href={withBase('/research/')}>Explore all research <span aria-hidden="true">↗</span></a></div><a class="research-preview" href={withBase(`/research/#${researchPreview.id}`)}><span class="eyebrow">{researchPreview.status} {researchPreview.year && ` / ${researchPreview.year}`}</span><h3>{researchPreview.title}</h3><p>{researchPreview.summary}</p><span class="link-arrow">Read the research record <span aria-hidden="true">↗</span></span></a></section>
  <section class="container section home-skills" aria-labelledby="home-skills-heading"><SectionHeading eyebrow="05 / Tools & engineering practice" title="Tools, with a practical purpose." description="Used or studied through undergraduate projects and supervised internship learning." id="home-skills-heading" /><div class="skills-groups"><article class="skills-group"><p class="eyebrow">Software & tools</p><h3>From analysis to implementation</h3><ul class="skills-list" data-home-tools>{softwareTools.map((tool, index) => <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{tool}</li>)}</ul></article><article class="skills-group"><p class="eyebrow">Engineering skills</p><h3>Connecting design and practice</h3><ul class="skills-list" data-home-skills>{engineeringSkills.map((skill, index) => <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{skill}</li>)}</ul></article></div></section>
  <section class="container contact-banner"><p class="eyebrow">Have a project in mind?</p><div><h2>Let’s connect<span class="accent">.</span></h2><Button href={withBase('/contact/#project-enquiry')}>Discuss a project</Button></div><p>Share your brief and contact details. I’ll review the scope and follow up about the support you need. <a href={withBase('/about/#services')}>Explore services</a>.</p><div class="home-contact-methods"><ContactMethods /></div></section>
</Layout>
<style>
  @layer components {
    .home-contact-methods { display: block; margin-top: 24px; }
  }
</style>
