---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';
---

<Layout title="Contact" description="Contact Muhammad Sharjeel for engineering opportunities, academic collaboration and project conversations." active="contact">
  <div class="container">
    <section class="page-intro">
      <p class="eyebrow">Contact</p>
      <h1>Let’s start<br />a conversation.</h1>
      <p class="intro-copy">For engineering opportunities, academic collaboration or a conversation about the work, reach me by email or LinkedIn.</p>
    </section>
    <section class="section two-column" aria-labelledby="contact-heading">
      <SectionHeading eyebrow={site.location} title="Get in touch" id="contact-heading" />
      <div class="contact-links">
        <a class="record contact-record" href={`mailto:${site.email}`}>
          <span class="eyebrow">Email</span>
          <span class="contact-value">{site.email}</span>
          <span class="muted">Opens your email application <span aria-hidden="true">↗</span></span>
        </a>
        <a class="record contact-record" href={site.linkedin}>
          <span class="eyebrow">Professional profile</span>
          <span class="contact-value">LinkedIn</span>
          <span class="muted">Connect with {site.name} <span aria-hidden="true">↗</span></span>
        </a>
        <a class="record contact-record" href={site.github}>
          <span class="eyebrow">GitHub profile</span>
          <span class="contact-value">engr-sharjeel</span>
          <span class="muted">Explore my GitHub profile <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </section>
  </div>
</Layout>
