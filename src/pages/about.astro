---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceOverview from '../components/ServiceOverview.astro';
import ProjectEnquiryForm from '../components/ProjectEnquiryForm.astro';
import Tag from '../components/Tag.astro';
import { site } from '../data/site';
import { skillGroups } from '../data/skills';
import { education } from '../data/education';
import { withBase } from '../lib/urls';
import '../styles/phase2-pages.css';
import '../styles/enquiry.css';
---

<Layout title="About" description="Meet Muhammad Sharjeel and explore engineering project support grounded in his power, embedded-system and design work." active="about">
  <div class="container">
    <section class="page-intro">
      <p class="eyebrow">About</p>
      <h1>Engineering through<br />study and practice.</h1>
      <p class="intro-copy">I’m {site.name}, a {site.role} at {site.university}. My degree is in progress, and my academic work connects power systems, electric mobility and embedded control.</p>
      <div class="button-row">
        <a class="button" href="#services">Discuss a project<span aria-hidden="true">↓</span></a>
        <a class="button button-secondary" href={withBase(site.resumePath)} download>Download CV <span class="sr-only">(PDF)</span><span aria-hidden="true">↓</span></a>
      </div>
    </section>
    <section class="section two-column" aria-labelledby="background-heading">
      <SectionHeading eyebrow="Background" title="A practical foundation" id="background-heading" />
      <div class="prose">
        <p>My projects range from a fabricated transformer and sensor-based robot to a rural micro hydropower design study. Each brings a different part of electrical engineering into focus: sizing, sensing, control, integration and testing.</p>
        <p>My current final-year project develops a range-extended electric vehicle prototype for areas with limited charging infrastructure. FYP-1 is complete, establishing the literature review, series architecture and integration methodology for the next stages. A longer-term ambition is a startup that converts existing vehicles into REEVs; that is a future direction, rather than a launched service.</p>
        <p>Internships at IESCO and POWERCHINA SEPCO1 have added exposure to utility systems and engineering project coordination.</p>
        <a class="link-arrow" href={withBase('/projects/')}>Explore the project catalogue <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <section class="section services-section" id="services" aria-labelledby="services-heading">
      <SectionHeading eyebrow="Work together" title="Services & project enquiries" id="services-heading" description="Practical support informed by my academic projects, engineering tools and internship learning." />
      <p class="service-introduction">Share the task you have in mind. Scope, availability, delivery format and cost can be agreed after I review your brief.</p>
      <ServiceOverview />
      <section class="about-enquiry enquiry-panel" id="project-enquiry" aria-labelledby="about-enquiry-heading">
        <div class="enquiry-panel-intro">
          <p class="eyebrow">Start with a brief</p>
          <h3 id="about-enquiry-heading">What do you need help with?</h3>
          <p>A few details about the task and how to reach you are enough to begin.</p>
        </div>
        <ProjectEnquiryForm id="about-enquiry" variant="compact" sourcePath="/about/" />
        <a class="link-arrow expanded-enquiry-link" href={withBase('/contact/#project-enquiry')}>Have a fuller project brief? <span aria-hidden="true">↗</span></a>
      </section>
    </section>
    <section class="section" aria-labelledby="education-heading">
      <SectionHeading eyebrow="Education" title={education.program} id="education-heading" />
      <article class="record">
        <div class="record-header"><h3>{education.institution}</h3><Tag>{education.status}</Tag></div>
        <p>{education.location} · {education.period}</p>
        <p class="muted">Academic interests include power systems, electric mobility, renewable energy and embedded systems.</p>
        <div class="about-education-details"><span>Current reported CGPA <strong>{education.cgpa}/{education.gpaScale}</strong></span><span>{education.reportTerm} snapshot</span></div>
        <a class="link-arrow" href={withBase('/education/')}>Explore education & coursework <span aria-hidden="true">↗</span></a>
      </article>
    </section>
    <section class="section" aria-labelledby="skills-heading">
      <SectionHeading eyebrow="Tools & practice" title="Skills used in the work" description="Applied across academic projects and internship learning." id="skills-heading" />
      <div class="records-grid">{skillGroups.map((group) => (
        <article class="record"><h3>{group.title}</h3><p>{group.context}</p><ul class="tags" role="list">{group.items.map((item) => <li><Tag>{item}</Tag></li>)}</ul></article>
      ))}</div>
    </section>
    <section class="section two-column" aria-labelledby="recognition-heading">
      <SectionHeading eyebrow="Beyond projects" title="Learning and recognition" id="recognition-heading" />
      <div class="prose"><p>Semester commendations, IEEE community engagement and additional courses support my continuing engineering education.</p><div class="about-learning-links"><a class="link-arrow" href={withBase('/certificates/')}>Browse certificates <span aria-hidden="true">↗</span></a><a class="link-arrow" href={withBase('/achievements/')}>View achievements <span aria-hidden="true">↗</span></a></div></div>
    </section>
  </div>
</Layout>
